# ── 运行时产物（非源码，换机按 RUNBOOK.md §5 重建）──
*.log
*.log.old
.service-pids
# install-watchdog 生成的静默启动器（含本机绝对路径，不入库）
watchdog-silent.vbs

# ── Python ──
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# ── Node（frontend/dist 是构建产物：npm run build 重建后再 restart backend）──
frontend/node_modules/
frontend/dist/

# ── 工具缓存 ──
.playwright-mcp/
.claude/settings.local.json
